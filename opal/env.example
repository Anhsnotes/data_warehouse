# =============================================================================
# OPA / OPAL Configuration
# =============================================================================
# Copy this file to .env and configure as needed:
#   cp env.example .env

# -----------------------------------------------------------------------------
# Standalone OPA Settings (default mode)
# -----------------------------------------------------------------------------
OPA_PORT=8181
OPA_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OPAL Settings (for Git-based policy management)
# Enable with: ./setup.sh start-opal
# -----------------------------------------------------------------------------

# Git repository URL containing your policies
# Can be the same repo as your project - just specify the subdirectory below
OPAL_POLICY_REPO_URL=https://github.com/YOUR_USERNAME/data_warehouse.git

# Branch to track (default: main)
OPAL_POLICY_REPO_BRANCH=main

# Subdirectory within the repo containing Rego policies
# For this project, policies are in opal/policies/
OPAL_REPO_POLICY_PATHS=opal/policies

# SSH key for private repositories (base64 encoded)
# Generate with: cat ~/.ssh/id_rsa | base64 -w 0
# Leave empty for public repos
OPAL_POLICY_REPO_SSH_KEY=

# OPAL ports
OPAL_SERVER_PORT=7002
OPAL_CLIENT_PORT=7001
OPAL_OPA_PORT=8183

# Log level (DEBUG, INFO, WARNING, ERROR)
OPAL_LOG_LEVEL=INFO
